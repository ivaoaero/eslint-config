{
  "name": "@ivao/eslint-config",
  "description": "IVAO ESLint config",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "default": "./dist/tailwind.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ivaoaero/eslint-config.git"
  },
  "author": {
    "name": "IVAO",
    "url": "https://ivao.aero"
  },
  "contributors": [
    {
      "name": "Jonas Bellmann (533870)",
      "email": "jonas.bellmann@ivao.aero",
      "url": "https://github.com/CptnJon"
    }
  ],
  "maintainers": [
    {
      "name": "Jonas Bellmann (533870)",
      "email": "jonas.bellmann@ivao.aero",
      "url": "https://github.com/CptnJon"
    }
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint . --cache --report-unused-disable-directives --max-warnings 0",
    "lint-fix": "eslint . --cache --report-unused-disable-directives --max-warnings 0 --fix",
    "format": "prettier . --write --cache",
    "release": "semantic-release"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "~0.5.3",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.64.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@ivao/prettier-config": "^1.3.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/node": "^24.12.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "~0.7.4",
    "semantic-release": "^25.0.8",
    "tsdown": "^0.22.9"
  },
  "peerDependencies": {
    "eslint": "^10.7.0",
    "eslint-plugin-storybook": "^10.5.2"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-storybook": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "prettier": "@ivao/prettier-config",
  "packageManager": "pnpm@11.14.0+sha512.66c1ac4c7d4762d6d7dde44c7f3e5a73591ed0a0806e751d4ed32d4f004f25b2285a906b1fd8a9e3e621df3b4e2858bf88e50e0cf626bedbe977fe434a5caf85"
}
